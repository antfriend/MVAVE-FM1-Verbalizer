+    fm1_verbalizer_render(rendered, FM1_BLOCK_FRAMES);
     fm1_output_mix(rendered);
     uint32_t flags = fm1_audio_irq_save();
     if (fm1_audio_half_owned(half) &&
@@ -82,6 +84,7 @@ void fm1_audio_resume(void)
 int fm1_audio_start(void)
 {
     if (initialized) return 0;
+    engine_linked = (uintptr_t)fm1_engine_render;
     uint32_t clock = fm1_device_clock();
     if (!clock) return -1;
     block_ticks = (uint32_t)((uint64_t)clock * FM1_BLOCK_FRAMES / FM1_AUDIO_HARDWARE_RATE);
diff --git a/app/instrument.h b/app/instrument.h
index 9ff80f9..28891e8 100644
--- a/app/instrument.h
+++ b/app/instrument.h
@@ -329,9 +329,14 @@ enum { GROOVE_SAMPLE_OFFSET = 69632, GROOVE_SAMPLE_BYTES = 466944,
 /* Five final sectors hold the four DX7 banks and tuning/session preferences.
  * New sample transfers stop before them. Larger legacy banks stay readable;
  * writes to overlapping extension storage are rejected before erasing Flash. */
+/* Verbalizer-only build: the two sectors before the DX7 banks hold the
+ * Verbalizer's knobs and the Bluetooth settings. The knobs are where the
+ * combined build keeps them, so a saved sound survives a change of build. */
 enum { GROOVE_TUNING_OFFSET = GROOVE_FLASH_BYTES - 4096,
        GROOVE_LIBRARY_OFFSET = GROOVE_TUNING_OFFSET - 4 * 4096,
-       GROOVE_SAMPLE_LIMIT = GROOVE_LIBRARY_OFFSET - GROOVE_SAMPLE_OFFSET };
+       GROOVE_VERBALIZER_OFFSET = GROOVE_LIBRARY_OFFSET - 4096,
+       GROOVE_SETTINGS_OFFSET = GROOVE_VERBALIZER_OFFSET - 4096,
+       GROOVE_SAMPLE_LIMIT = GROOVE_SETTINGS_OFFSET - GROOVE_SAMPLE_OFFSET };
 /* Finish any committed shared journal before starting a new transaction. */
 int groove_storage_prepare(void);
 void groove_samples_init(void);
